{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskList",
  "version": "1.5.12",
  "identifier": "com.workbuddy.desklist",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Desk List",
        "width": 420,
        "height": 320,
        "minWidth": 360,
        "minHeight": 120,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AutofillServerCommunication,AutofillEnableAccountWalletStorage,AutofillEnablePayments,AutofillEnableOfferNotification --disable-gpu --disable-gpu-sandbox",
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "shortDescription": "贴在桌面上的待办清单",
    "longDescription": "只有事项文字和 CheckBox 的极简清单，平时鼠标穿透，按住 Ctrl 才活。"
  }
}
